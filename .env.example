# ============================================================
# BACKEND ENVIRONMENT VARIABLES TEMPLATE
# ============================================================
# Copy file này thành .env và điền các giá trị thật của bạn

DB_USERNAME=root
DB_PASSWORD=your_secure_db_password
DB_URL=jdbc:mysql://mysql:3306/backend

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# JWT Signer Key (Tối thiểu 64 ký tự ngẫu nhiên)
JWT_SIGNER_KEY=generate_a_random_secure_key_at_least_64_characters_long

# CORS: thêm domain frontend production (cách nhau bằng dấu phẩy)
CORS_ALLOWED_ORIGINS=https://your-portfolio.vercel.app,http://localhost:5173

# Admin Account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password
